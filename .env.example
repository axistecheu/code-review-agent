# Ollama Configuration (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:70b

# GitHub Configuration
# Create a Personal Access Token with 'repo' scope at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Secret for validating GitHub webhooks (create a random string)
# This should match the secret you configure in your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Telegram Configuration (Optional)
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat ID by messaging your bot and visiting:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# Server Configuration
PORT=4111
NODE_ENV=development
