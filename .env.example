# =============================================================================
# Code Review Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Ollama Configuration (Required)
# -----------------------------------------------------------------------------
# URL of your Ollama server (local or remote)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use for code reviews
# Recommended models with tool support: qwen3:8b, llama3.2-vision:latest
# Note: deepseek-r1 models don't support tools
OLLAMA_MODEL=qwen3:8b

# -----------------------------------------------------------------------------
# GitHub Configuration (Required)
# -----------------------------------------------------------------------------
# Personal Access Token with 'repo' scope
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here

# Secret for validating GitHub webhook signatures
# Create a random string and use the same value in your GitHub webhook settings
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# Telegram Configuration (Optional)
# -----------------------------------------------------------------------------
# Bot token from @BotFather on Telegram
# Leave empty to disable Telegram notifications
TELEGRAM_BOT_TOKEN=

# Chat ID to send notifications to
# Get by messaging your bot and visiting:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Port to run the server on
PORT=4111

# Environment mode
NODE_ENV=development
